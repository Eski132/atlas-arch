#!/usr/bin/env bash
set -euo pipefail

PROGRAM='cloudpath-arch'
RUNTIME_HELPER='/usr/lib/cloudpath-arch/cloudpath-arch-ns'
TRUSTED_ROOT_PATH='/usr/local/sbin:/usr/local/bin:/usr/bin:/bin'

# The EXIT trap owns cleanup. Signal handlers only stop the child and preserve
# the signal status; they never remove the payload while it may be running.
tmp=''
launch_pid=''
signal_status=0
signal_seen=0

usage() {
  cat <<'USAGE'
Usage:
  cloudpath-arch /path/to/Cloudpath-x64.tar.bz2
  cloudpath-arch --check /path/to/Cloudpath-x64.tar.bz2

Runs a user's own Cloudpath Linux installer on Arch Linux without modifying
Arch's distro identification files. The archive is unpacked into a private
temporary directory and removed after the installer exits.
USAGE
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

need_command() {
  local command=$1
  [[ -x "$command" ]] || die "missing required command: $command"
}

append_if_set() {
  local -n output=$1
  local name=$2
  if [[ -v $name ]]; then
    output+=("$name=${!name}")
  fi
}

archive_path_is_safe() {
  local entry=$1 component
  [[ -n "$entry" ]] || return 1
  [[ "$entry" != /* ]] || return 1
  IFS='/' read -r -a components <<< "$entry"
  for component in "${components[@]}"; do
    [[ "$component" != '..' ]] || return 1
  done
}

validate_archive() {
  local archive=$1 listing details line type entry
  listing=$(/usr/bin/mktemp)
  details=$(/usr/bin/mktemp)

  if ! /usr/bin/tar -tjf "$archive" >"$listing"; then
    /usr/bin/rm -f -- "$listing" "$details"
    die 'archive cannot be listed; it may be malformed or truncated'
  fi

  if ! /usr/bin/tar -tvjf "$archive" >"$details"; then
    /usr/bin/rm -f -- "$listing" "$details"
    die 'archive metadata cannot be read; it may be malformed or truncated'
  fi

  while IFS= read -r line; do
    type=${line:0:1}
    case "$type" in
      -|d) ;;
      *)
        /usr/bin/rm -f -- "$listing" "$details"
        die 'archive contains a link, device, FIFO, socket, or other unsupported entry'
        ;;
    esac
  done < "$details"

  while IFS= read -r entry; do
    archive_path_is_safe "$entry" || {
      /usr/bin/rm -f -- "$listing" "$details"
      die "archive contains an unsafe path: $entry"
    }
  done < "$listing"

  /usr/bin/rm -f -- "$listing" "$details"
}

find_payload_root() {
  local dir=$1 candidates candidate root
  candidates=$(/usr/bin/mktemp)
  if ! /usr/bin/find "$dir" -type f -name 'Cloudpath-x64' -print >"$candidates"; then
    /usr/bin/rm -f -- "$candidates"
    return 1
  fi

  local valid=()
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    root=${candidate%/Cloudpath-x64}
    if [[ -f "$root/network_config.xml" && -f "$root/session.properties" ]]; then
      valid+=("$root")
    fi
  done < "$candidates"
  /usr/bin/rm -f -- "$candidates"

  if (( ${#valid[@]} == 0 )); then
    return 1
  fi
  if (( ${#valid[@]} != 1 )); then
    return 2
  fi
  printf '%s\n' "${valid[0]}"
}

show_check() {
  local root=$1 network='unknown' licensee='unknown'
  network=$(/usr/bin/sed -n 's:.*<name>\([^<]*\)</name>.*:\1:p' "$root/network_config.xml" | /usr/bin/head -n1 || true)
  licensee=$(/usr/bin/sed -n 's:.*<licensee>\([^<]*\)</licensee>.*:\1:p' "$root/network_config.xml" | /usr/bin/head -n1 || true)

  printf 'Archive looks usable.\n'
  printf '  Network: %s\n' "$network"
  printf '  Licensee: %s\n' "$licensee"
  printf '  Executable: %s\n' "$(/usr/bin/file -b "$root/Cloudpath-x64")"

  if /usr/bin/grep -q '^authorizationToken=' "$root/session.properties"; then
    printf '  Enrollment token: present (value intentionally not displayed)\n'
  else
    printf '  Enrollment token: not found\n'
  fi

  if /usr/bin/grep -q '^enrollmentGuid=' "$root/session.properties"; then
    printf '  Enrollment GUID: present (value intentionally not displayed)\n'
  else
    printf '  Enrollment GUID: not found\n'
  fi
}

cleanup() {
  if [[ -n "$tmp" && -d "$tmp" ]]; then
    /usr/bin/rm -rf -- "$tmp" || true
  fi
}

on_signal() {
  local signal=$1
  case "$signal" in
    INT) signal_status=130 ;;
    TERM) signal_status=143 ;;
    HUP) signal_status=129 ;;
  esac

  if [[ -n "$launch_pid" ]] && /usr/bin/kill -0 "$launch_pid" 2>/dev/null; then
    # setsid gives the sudo/unshare/vendor chain its own process group. Signal
    # the whole group so descendants cannot outlive the parent cleanup.
    if (( signal_status != 0 && ${signal_seen:-0} != 0 )); then
      /usr/bin/kill -KILL -- "-$launch_pid" 2>/dev/null || true
    else
      /usr/bin/kill -TERM -- "-$launch_pid" 2>/dev/null || /usr/bin/kill -TERM "$launch_pid" 2>/dev/null || true
    fi
    signal_seen=1
  elif [[ -z "$launch_pid" ]]; then
    exit "$signal_status"
  fi
}

run_child_and_wait() {
  local -n child_command=$1
  local launch_status
  "${child_command[@]}" &
  launch_pid=$!
  if wait "$launch_pid"; then
    launch_status=0
  else
    launch_status=$?
  fi
  launch_pid=''

  if (( signal_status != 0 )); then
    return "$signal_status"
  fi
  return "$launch_status"
}

main() {
  local check_only=0 archive payload_root payload_status runtime_base uid gid
  local launch_status
  # shellcheck disable=SC2034 # passed by name to run_child_and_wait
  local -a root_env=() launch_command=()

  if [[ ${1:-} == '--check' ]]; then
    check_only=1
    shift
  fi

  [[ $# -eq 1 ]] || { usage >&2; exit 2; }
  archive=$1
  [[ -f "$archive" ]] || die "archive not found: $archive"
  [[ -r "$archive" ]] || die "archive is not readable: $archive"
  [[ $(/usr/bin/uname -m) == 'x86_64' ]] || die 'this wrapper supports x86_64 Cloudpath installers only'
  [[ -e /etc/arch-release ]] || die 'this package is intended for Arch Linux and Arch-based systems'

  need_command /usr/bin/mktemp
  need_command /usr/bin/rm
  need_command /usr/bin/tar
  need_command /usr/bin/find
  need_command /usr/bin/file
  need_command /usr/bin/grep
  need_command /usr/bin/sed
  need_command /usr/bin/chmod

  validate_archive "$archive"

  umask 077
  runtime_base=${XDG_RUNTIME_DIR:-/tmp}
  if [[ ! -d "$runtime_base" || ! -w "$runtime_base" ]]; then
    runtime_base=/tmp
  fi
  tmp=$(/usr/bin/mktemp -d "$runtime_base/cloudpath-arch.XXXXXXXX")
  trap cleanup EXIT
  trap 'on_signal INT' INT
  trap 'on_signal TERM' TERM
  trap 'on_signal HUP' HUP

  /usr/bin/mkdir -p -- "$tmp/payload"
  if ! /usr/bin/tar -xjf "$archive" -C "$tmp/payload" --no-same-owner --no-same-permissions --no-overwrite-dir; then
    die 'archive extraction failed; it may be malformed or truncated'
  fi

  if payload_root=$(find_payload_root "$tmp/payload"); then
    :
  else
    payload_status=$?
    if (( payload_status == 2 )); then
      die 'archive contains more than one valid Cloudpath payload'
    fi
    die 'archive does not contain one valid Cloudpath payload'
  fi
  /usr/bin/chmod u+x "$payload_root/Cloudpath-x64"

  if (( check_only )); then
    show_check "$payload_root"
    exit 0
  fi

  [[ -x "$RUNTIME_HELPER" ]] || die "runtime helper missing: $RUNTIME_HELPER"
  need_command /usr/bin/sudo
  need_command /usr/bin/setsid
  need_command /usr/bin/systemctl
  /usr/bin/systemctl -q is-active NetworkManager.service || die 'NetworkManager is not running; start it explicitly before enrollment'

  root_env+=("PATH=$TRUSTED_ROOT_PATH")
  for name in DISPLAY WAYLAND_DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS \
    XDG_RUNTIME_DIR XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
    XDG_CONFIG_HOME XDG_DATA_HOME XDG_DATA_DIRS LANG LC_ALL LC_CTYPE; do
    append_if_set root_env "$name"
  done

  printf 'Starting Cloudpath with temporary Ubuntu compatibility metadata.\n'
  printf 'The archive is in a private temporary directory and will be deleted after the installer exits.\n'
  printf 'This mount namespace is not a sandbox: Cloudpath can access your files and the real NetworkManager.\n'

  # shellcheck disable=SC2034 # passed by name to run_child_and_wait
  launch_command=(/usr/bin/setsid /usr/bin/sudo /usr/bin/env "${root_env[@]}" "$RUNTIME_HELPER" "$uid" "$gid" "$payload_root")
  if run_child_and_wait launch_command; then
    launch_status=0
  else
    launch_status=$?
  fi

  if (( launch_status == 134 )); then
    printf '%s: Cloudpath aborted with exit status 134. The vendor process terminated abnormally; the internal cause is unconfirmed.\n' "$PROGRAM" >&2
    printf '%s: inspect local diagnostics with: coredumpctl info Cloudpath-x64\n' "$PROGRAM" >&2
  fi
  return "$launch_status"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
